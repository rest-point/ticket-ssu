# Local team environment. Copy to .env; run: npm run start:local
# npm start does not read .env. Existing shell variables override this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Relative paths resolve from the project root when using npm scripts.
# This is a separate local demo DB; never point tests at data/ticket-ssu.sqlite.
DB_PATH=data/team-local.sqlite
DB_SCHEMA=model
DEMO_MODE=true
SHUTDOWN_TIMEOUT_MS=10000
# For a separate deployment: DEMO_MODE=false, NODE_ENV=production, HTTPS,
# authenticated loopback proxy (PUBLIC_ORIGIN/PROXY_TOKEN/PROXY_IP),
# and administrator credentials injected outside version control.
# See README.md and .env.tunnel.example for public HTTPS demonstration.
# TICKET_SSU_ADMIN_EMAIL=
# TICKET_SSU_ADMIN_PASSWORD=
# Optional queue/limit overrides: see docs/design/api.md.
