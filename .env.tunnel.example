# Windows x64: npm run setup:tunnel, then npm run start:tunnel.
# Fill the dedicated administrator pair locally. Never share this file.
# Existing shell variables override this file; remove stale PUBLIC_ORIGIN/PROXY_TOKEN.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=data/tunnel-demo.sqlite
DB_SCHEMA=model
DEMO_MODE=false
TUNNEL_PORT=3001
TUNNEL_TIMEOUT_MS=30000
# auto, quic, or http2; HTTP2 still requires outbound TCP 7844.
TUNNEL_PROTOCOL=auto
# PUBLIC_ORIGIN and PROXY_TOKEN are generated in memory; do not set them here.
PROXY_IP=127.0.0.1
TICKET_SSU_ADMIN_EMAIL=
TICKET_SSU_ADMIN_PASSWORD=
SHUTDOWN_TIMEOUT_MS=10000
